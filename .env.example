# Who writes the prompts when you don't choose: gemini or claude.
# LLM_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key
# One model or a comma-separated chain, tried in order.
# GEMINI_MODEL=gemini-3.5-flash

# From platform.claude.com. Paid per use.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# COMFYUI_URL=http://127.0.0.1:8188
# The panel starts ComfyUI with this when a render needs it, and Shut down closes it again.
# COMFYUI_LAUNCHER=C:\Projects\ComfyUI\run_nvidia_gpu.bat
# Another workflow, with a .map.json next to it.
# COMFYUI_WORKFLOW=C:\path\to\workflow.json
# Longest one clip may take in seconds, including time waiting in ComfyUI's queue.
# COMFYUI_TIMEOUT=3600

# Web panel. Needed to reach it from your phone: without it, it only answers this PC.
APP_PASSWORD=
FLASK_SECRET_KEY=

# YouTube upload: run scripts/authorize_youtube.py once and paste what it prints.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
